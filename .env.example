DATABASE_URL=sqlite://blackwall.db?mode=rwc
BIND_ADDR=127.0.0.1:3000
RUST_LOG=blackwall=info
# Set this behind HTTPS to mark session cookies Secure.
COOKIE_SECURE=false
# Email jobs send over SMTP. Use smtps:// for implicit TLS or smtp://...?tls=required for
# STARTTLS, with credentials percent-encoded in the URL.
# SMTP_URL=smtps://user:password@smtp.example.com
# SMTP_FROM="Blackwall <noreply@example.com>"
# For local development, `docker compose up -d` starts mailpit. Its inbox is http://localhost:8025.
# SMTP_URL=smtp://127.0.0.1:1025
# SMTP_FROM="Blackwall <noreply@blackwall.localhost>"
# Or write mail to a local JSON spool instead. This takes precedence over SMTP. Never enable it on
# a public host.
# DEV_MAIL_DIR=./dev-mail
