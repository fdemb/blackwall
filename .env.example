DATABASE_URL=sqlite://blackwall.db?mode=rwc
BIND_ADDR=127.0.0.1:3000
RUST_LOG=blackwall=info
# Set this behind HTTPS to mark session cookies Secure.
COOKIE_SECURE=false
# Email jobs POST {to, subject, token} to your trusted mail delivery adapter.
# EMAIL_WEBHOOK_URL=https://mail.example.com/blackwall
# EMAIL_WEBHOOK_TOKEN=replace-with-a-secret
# Or explicitly use a local development spool. Never enable it on a public host.
# DEV_MAIL_DIR=./dev-mail
