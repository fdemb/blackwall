DATABASE_URL=postgres://blackwall:blackwall@127.0.0.1:5432/blackwall
# Tests create disposable databases. This user needs CREATEDB.
TEST_POSTGRES_URL=postgres://blackwall:blackwall@127.0.0.1:5432/blackwall
DATABASE_MAX_CONNECTIONS=16
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
BIND_ADDR=127.0.0.1:3000
RUST_LOG=blackwall=info
# Set this behind HTTPS to mark session cookies Secure.
COOKIE_SECURE=false
# Email jobs send over SMTP. Use smtps:// for implicit TLS or smtp://...?tls=required for
# STARTTLS, with credentials percent-encoded in the URL.
# SMTP_URL=smtps://user:password@smtp.example.com
# SMTP_FROM="Blackwall <noreply@example.com>"
# For local development, `docker compose up -d` starts mailpit. Its inbox is http://localhost:8025.
# SMTP_URL=smtp://127.0.0.1:1025
# SMTP_FROM="Blackwall <noreply@blackwall.localhost>"
# Or write mail to a local JSON spool instead. DEV_MAIL_DIR and SMTP_URL are mutually exclusive.
# Never enable the spool on a public host.
# DEV_MAIL_DIR=./dev-mail

# PostgreSQL worker limits. Polling is required even with LISTEN/NOTIFY.
JOBS_EMAIL_CONCURRENCY=4
JOBS_WEBHOOK_CONCURRENCY=4
JOBS_DATABASE_CONCURRENCY=2
# Issue trackers have their own bounded queue (1-4, default 2); remote requests never hold DB transactions.
# JOBS_OPENPROJECT_CONCURRENCY is still read when this is unset. DATABASE_MAX_CONNECTIONS must be
# at least JOBS_DATABASE_CONCURRENCY + JOBS_TRACKER_CONCURRENCY + 3.
JOBS_TRACKER_CONCURRENCY=2
JOBS_POLL_MS=5000
JOBS_DRAIN_SECONDS=50
# Successful, cancelled, and failed history expires after its own retention.
JOBS_RETENTION_DAYS=30
JOBS_FAILED_RETENTION_DAYS=90
