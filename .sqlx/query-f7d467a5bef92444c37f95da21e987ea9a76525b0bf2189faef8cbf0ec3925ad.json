  "query": "SELECT i.title,i.description,i.stage_id,s.name AS stage_name,i.assignee,u.email AS \"email?\",i.deadline,i.tracker AS \"tracker!\" FROM issues i JOIN stages s ON s.id=i.stage_id LEFT JOIN users u ON u.id=i.assignee WHERE i.workspace_id=$1 AND i.id=$2 AND i.tracker IS NOT NULL",
